### 1. PRUEBA DE AUTENTICACION (Obtener Token BANTEC)
# Si esto responde 200 OK con un token, la seguridad funciona.
# @name login
POST {{cognitoAuthUrl}}
Content-Type: application/x-www-form-urlencoded
Authorization: Basic N29qMTJqdHU4ZDNrZWlsdjFlMWdqa2M4ZTQ6MTZvOWJkcHBpMnFrdTY5dnVrN3FkY2ltNGZxcmtta2dnZGVyM2lxNDdwOWNzMjl0cXFvcQ==

grant_type=client_credentials
&scope={{scope}}

# Nota: El header Authorization es Base64(ById:Secret) de BANTEC.
# Calculado previamente para facilitar la prueba.


### Variable para guardar el token automáticamente
@authToken = {{login.response.body.access_token}}


### 2. TRANSFERENCIA INTERBANCARIA (A través de APIM)
# Usa el token obtenido arriba
POST {{apimUrl}}/api/v2/switch/transfers
Authorization: Bearer {{authToken}}
Content-Type: application/json
X-Trace-ID: {{$guid}}

{
  "header": {
    "messageId": "MSG-APIM-{{$guid}}",
    "creationDateTime": "2026-02-10T15:30:00Z",
    "originatingBankId": "ARCBANK"
  },
  "body": {
    "instructionId": "INSTR-APIM-{{$guid}}",
    "endToEndId": "E2E-APIM-{{$guid}}",
    "amount": {
      "currency": "USD",
      "value": 500.00
    },
    "debtor": {
      "name": "Cliente Origen APIM",
      "account": "100200300",
      "bankId": "ARCBANK"
    },
    "creditor": {
      "name": "Cliente Destino APIM",
      "account": "900800700",
      "bankId": "BANTEC"
    },
    "remittanceInformation": "Prueba via APIM Gateway"
  }
}


### 3. CONSULTA DE ESTADO (Traceability)
GET {{apimUrl}}/api/v2/switch/transfers/INSTR-APIM-{{$guid}}
Authorization: Bearer {{authToken}}


### 4. VALIDACIÓN DE CUENTA (Account Lookup)
POST {{apimUrl}}/api/v2/switch/account-lookup
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "header": {
    "messageId": "LKP-{{$guid}}",
    "originatingBankId": "ARCBANK"
  },
  "body": {
    "requestId": "REQ-{{$guid}}",
    "targetBankId": "BANTEC",
    "targetAccountNumber": "900800700"
  }
}


### 5. DEVOLUCIÓN / REVERSO (pacs.004)
# Reemplazar 'original-instruction-id' con uno real
POST {{apimUrl}}/api/v2/switch/returns
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "header": {
    "messageId": "RET-APIM-{{$guid}}",
    "originatingBankId": "ARCBANK"
  },
  "body": {
    "returnInstructionId": "RET-{{$guid}}",
    "originalInstructionId": "INSTR-APIM-XYZ123",
    "returnReason": "DUPL",
    "returnAmount": {
      "currency": "USD",
      "value": 500.00
    }
  }
}
